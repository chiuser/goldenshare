# Deployment sudo whitelist for user `goldenshare`.
# Keep commands explicit to avoid broad root permissions.
goldenshare ALL=(root) NOPASSWD: \
  /usr/bin/systemctl daemon-reload, \
  /usr/bin/systemctl cat goldenshare-web.service, \
  /usr/bin/systemctl restart goldenshare-web.service, \
  /usr/bin/systemctl restart goldenshare-ops-worker.service, \
  /usr/bin/systemctl restart goldenshare-ops-scheduler.service, \
  /usr/bin/systemctl restart goldenshare-date-completeness-worker.service, \
  /usr/bin/systemctl restart goldenshare-ops-task-completion-worker.service, \
  /usr/bin/systemctl restart goldenshare-ops-stk-mins-worker.service, \
  /usr/bin/systemctl restart goldenshare-ops-index-mins-worker.service, \
  /usr/bin/systemctl restart goldenshare-qtf-worker.service, \
  /usr/bin/systemctl restart goldenshare-realtime-collector.service, \
  /usr/bin/systemctl enable goldenshare-date-completeness-worker.service, \
  /usr/bin/systemctl enable goldenshare-ops-task-completion-worker.service, \
  /usr/bin/systemctl enable goldenshare-ops-stk-mins-worker.service, \
  /usr/bin/systemctl enable goldenshare-ops-index-mins-worker.service, \
  /usr/bin/systemctl enable goldenshare-qtf-worker.service, \
  /usr/bin/systemctl enable goldenshare-realtime-collector.service, \
  /usr/bin/systemctl status goldenshare-web.service, \
  /usr/bin/systemctl status goldenshare-ops-worker.service, \
  /usr/bin/systemctl status goldenshare-ops-scheduler.service, \
  /usr/bin/systemctl status goldenshare-date-completeness-worker.service, \
  /usr/bin/systemctl status goldenshare-ops-task-completion-worker.service, \
  /usr/bin/systemctl status goldenshare-ops-stk-mins-worker.service, \
  /usr/bin/systemctl status goldenshare-ops-index-mins-worker.service, \
  /usr/bin/systemctl status goldenshare-qtf-worker.service, \
  /usr/bin/systemctl status goldenshare-realtime-collector.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-web.service /etc/systemd/system/goldenshare-web.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-ops-worker.service /etc/systemd/system/goldenshare-ops-worker.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-ops-scheduler.service /etc/systemd/system/goldenshare-ops-scheduler.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-date-completeness-worker.service /etc/systemd/system/goldenshare-date-completeness-worker.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-ops-task-completion-worker.service /etc/systemd/system/goldenshare-ops-task-completion-worker.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-ops-stk-mins-worker.service /etc/systemd/system/goldenshare-ops-stk-mins-worker.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-ops-index-mins-worker.service /etc/systemd/system/goldenshare-ops-index-mins-worker.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-qtf-worker.service /etc/systemd/system/goldenshare-qtf-worker.service, \
  /usr/bin/install -m 644 /opt/goldenshare/goldenshare/scripts/goldenshare-realtime-collector.service /etc/systemd/system/goldenshare-realtime-collector.service
